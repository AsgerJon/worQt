# claude-safe: run claude inside a bubblewrap sandbox.
#
# What is visible to claude inside the sandbox:
#   read-only:  /usr, /etc, /opt (system binaries, certs)
#   read-write: the directory you launched from
#   read-write: ~/.claude (claude's own state and auth)
#   read-write: ~/.npm-global (where the claude CLI lives
#               if installed via npm; harmless if absent)
#
# What is NOT visible to claude:
#   the rest of $HOME, including .ssh, .gnupg, dotfiles,
#   sibling project directories, Documents, Downloads,
#   shell history, browser data, anything else under /home
#
# Network: full network access (claude needs the API).
#
# Usage: cd into a project, then run `claude-safe`.

set -euo pipefail

# Re-exec inside a fresh Alacritty window using a Claude-specific
# config so plain Enter inserts a newline and Ctrl+Enter submits.
# Skip if already inside the spawned instance.
TOML="$HOME/.config/alacritty/claude.toml"
if [ -z "${CLAUDE_SAFE_INNER:-}" ] && [ -f "$TOML" ]; then
  SELF="$(readlink -f "${BASH_SOURCE[0]}")"
  exec env CLAUDE_SAFE_INNER=1 alacritty \
    --config-file "$TOML" -e "$SELF" "$@"
fi

PROJECT="$(pwd)"
USER_HOME="$HOME"
NPM_BIN="${NPM_BIN:-$USER_HOME/.npm-global}"

CLAUDE=$(command -v claude) || {
  echo "claude not found in PATH" >&2
  exit 1
}

EXTRA=()
[ -d "$NPM_BIN" ] && EXTRA+=( --bind "$NPM_BIN" "$NPM_BIN" )
# Expose the miniforge3 install read-only so claude can run the
# worqt_env interpreter (PySide6, worktoy, etc.). Read-only keeps
# the sandbox intent: claude can execute the env but not mutate it.
[ -d "$USER_HOME/miniforge3" ] && EXTRA+=(
  --ro-bind "$USER_HOME/miniforge3" "$USER_HOME/miniforge3"
)
[ -f "$USER_HOME/.claude.json" ] && EXTRA+=(
  --bind "$USER_HOME/.claude.json" "$USER_HOME/.claude.json"
)
# Ignore SIGINT in this wrapper so a Ctrl+C inside claude does not
# also kill the script — otherwise bash exits before the shell
# handoff below and alacritty closes the window. claude itself
# still receives SIGINT directly from the kernel (foreground pgrp).
if [ -n "${CLAUDE_SAFE_INNER:-}" ]; then
  trap '' INT
fi

status=0
bwrap \
  --ro-bind /usr /usr \
  --ro-bind /etc /etc \
  --ro-bind /opt /opt \
  --symlink usr/lib /lib \
  --symlink usr/lib64 /lib64 \
  --symlink usr/bin /bin \
  --symlink usr/sbin /sbin \
  --proc /proc \
  --dev /dev \
  --tmpfs /tmp \
  --tmpfs "$USER_HOME" \
  --bind "$PROJECT" "$PROJECT" \
  --bind "$USER_HOME/.claude" "$USER_HOME/.claude" \
  "${EXTRA[@]}" \
  --setenv HOME "$USER_HOME" \
  --setenv USER "$(id -un)" \
  --share-net \
  --die-with-parent \
  --chdir "$PROJECT" \
  -- "$CLAUDE" "$@" || status=$?

# When launched inside our spawned alacritty window, drop into a
# normal interactive shell so the window stays open like any other
# terminal.
if [ -n "${CLAUDE_SAFE_INNER:-}" ]; then
  exec "${SHELL:-/bin/bash}" -i
fi
exit "$status"
